{
  "buildCommand": "npx expo export -p web && node scripts/web-postbuild.js dist",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/apple-developer-domain-association.txt",
      "destination": "https://gbenibgytweskljxneup.supabase.co/.well-known/apple-developer-domain-association.txt"
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "destination": "/.well-known/apple-app-site-association"
    },
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/.well-known/assetlinks.json"
    },
    {
      "source": "/invite/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebot|twitterbot|whatsapp|slackbot|slack-imgproxy|telegrambot|discordbot|linkedinbot|skypeuripreview|pinterest|redditbot|applebot|embedly|iframely|vkshare|snapchat|bluesky|mastodon|google-pagerenderer|googlebot|bingbot|signal).*"
        }
      ],
      "destination": "/api/share-preview?token=:token"
    },
    {
      "source": "/invite/:token",
      "destination": "/invite/[token]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(iphone|ipad|ipod).*"
        },
        {
          "type": "query",
          "key": "c",
          "value": "(?<c>[A-Za-z0-9_-]{1,40})"
        }
      ],
      "destination": "https://apps.apple.com/app/apple-store/id6761397970?pt=128723220&mt=8&ct=:c",
      "permanent": false
    },
    {
      "source": "/app",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(iphone|ipad|ipod).*"
        }
      ],
      "destination": "https://apps.apple.com/app/apple-store/id6761397970?pt=128723220&mt=8&ct=link",
      "permanent": false
    },
    {
      "source": "/app",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*android.*"
        }
      ],
      "destination": "https://play.google.com/store/apps/details?id=com.sudssocial.app",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/",
      "permanent": false
    }
  ]
}
